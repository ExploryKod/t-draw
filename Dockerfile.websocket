FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY websocket/ ./websocket/

# Install dependencies (including dotenv which is needed for .env loading)
RUN npm ci --production && npm install dotenv

# Copy environment files (will be overridden by env_file in docker-compose)
COPY .env.production* ./

# Expose WebSocket port
EXPOSE 8001

# Start WebSocket server
CMD ["node", "websocket/index.js"]

